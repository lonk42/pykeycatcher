---
# Find the key code for each key with: pykeycatcher.py --manual

# MQTT broker, for mqtt actions. Port 1883, no authentication
mqtt_host: 192.168.1.1

# USB IDs in decimal. lsusb prints them in hex: 1189:8890 is 4489, 34960
device:
  vendor_id: 4489
  product_id: 34960

# Integers that actions can change and publish
values:
  brightness:
    value: 128
    clamp:
      min: 0
      max: 255

actions:
  # Send the key on to the desktop, as the evdev key with the same number (KEY_F20)
  190:
    mirror: true

  # Dial left and right: step the brightness by 20% and publish it
  232:
    values:
      - name: brightness
        adjust_log_percent: -20
    mqtt:
      - topic: office/light/brightness
        value: brightness
  234:
    values:
      - name: brightness
        adjust_log_percent: 20
    mqtt:
      - topic: office/light/brightness
        value: brightness

  # Dial press: publish a fixed message
  233:
    mqtt:
      - topic: office/light
        message: "T"

  # Step the brightness down by a fixed amount
  235:
    values:
      - name: brightness
        adjust: -32
    mqtt:
      - topic: office/light/brightness
        value: brightness

  # Run a shell command in the background
  236:
    process:
      - command: 'notify-send "Key 236 pressed"'
